# Copy to .env and fill in. Never commit .env.

# Local Neo4j (Docker Compose or the portable install from `sgraph setup-portable`)
NEO4J_URI=neo4j://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-local
NEO4J_DATABASE=neo4j

# AuraDB Free (public demo) - from the credentials file Aura gives you when the instance is created
AURA_URI=neo4j+s://<instance-id>.databases.neo4j.io
AURA_USER=neo4j
AURA_PASSWORD=
AURA_DATABASE=neo4j
