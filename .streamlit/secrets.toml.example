# Copy to .streamlit/secrets.toml (git-ignored) or paste into Streamlit Cloud > App settings > Secrets.
[neo4j]
uri = "neo4j+s://<instance-id>.databases.neo4j.io"
user = "<instance-id>"        # new Aura instances: user = instance id
password = "<aura-password>"
database = "<instance-id>"    # new Aura instances: database = instance id
